BACKEND_IMAGE=ghcr.io/OWNER/freelanceflow-backend
FRONTEND_IMAGE=ghcr.io/OWNER/freelanceflow-frontend
IMAGE_TAG=full-commit-sha
APP_ORIGIN=https://freelance.example.com
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=5174
POSTGRES_DB=freelanceflow
POSTGRES_USER=freelanceflow_app
POSTGRES_PASSWORD=replace-on-host
JWT_SECRET=replace-on-host-with-at-least-32-random-bytes
POSTGRES_DATA_PATH=/srv/freelanceflow/postgres
