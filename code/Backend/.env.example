# PostgreSQL / Docker
POSTGRES_DB=freelanceflow
POSTGRES_USER=freelanceflow
POSTGRES_PASSWORD=
POSTGRES_PORT=5433

# Application
APP_PORT=8081
SERVER_PORT=8081

# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/freelanceflow
SPRING_DATASOURCE_USERNAME=freelanceflow
SPRING_DATASOURCE_PASSWORD=

# JPA
SPRING_JPA_DEFAULT_SCHEMA=public

# Flyway
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_BASELINE_ON_MIGRATE=false
SPRING_FLYWAY_SCHEMAS=public

# JWT
JWT_SECRET=
JWT_EXPIRATION=900000
REFRESH_EXPIRATION_MS=604800000
REFRESH_COOKIE_SECURE=false

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://localhost:8081

# OpenAPI / Swagger
OPENAPI_ENABLED=true

# Logging
LOG_LEVEL=INFO
SHOW_SQL=false
